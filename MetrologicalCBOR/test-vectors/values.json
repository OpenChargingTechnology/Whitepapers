            "source": "spec §5",
            "hex": "D9ACDC83C48221186E0203",
            "text": "1.10 kWh",
            "parseTexts": [
                {
                    "text": "1.1 kWh",
                    "hex": "D9ACDC83C482200B0203",
                    "expect": "accept"
                },
                {
                    "text": "1.10 KWh",
                    "expect": "reject"
                }
            ]
        },
        {
            "id": "spec5-05-uncertainty-decimal",
