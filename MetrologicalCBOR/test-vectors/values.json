{
    "suite": "values",
    "description": "Valid metrological values: wire bytes, canonical re-encoding, canonical text, text parsing.",
    "cases": [
        {
            "id": "spec5-01-int-ampere",
            "description": "5 A — integer value, single-byte unit id",
            "source": "spec §5",
            "hex": "D9ACDC820504",
            "text": "5 A",
            "parseTexts": [
                {
                    "text": "+5 A",
                    "expect": "accept"
                },
                {
                    "text": " 5 A ",
                    "expect": "survey"
                },
                {
                    "text": "5e0 A",
                    "expect": "accept"
                }
            ]
        },
        {
            "id": "spec5-02-int-volt",
            "description": "230 V — two-byte integer value",
            "source": "spec §5",
            "hex": "D9ACDC8218E605",
            "text": "230 V"
        },
        {
            "id": "spec5-03-decimal-milliamp",
            "description": "5.0 mA — decimal fraction, milli prefix",
            "source": "spec §5",
            "hex": "D9ACDC83C4822018320422",
            "text": "5.0 mA",
            "parseTexts": [
                {
                    "text": "5.0mA",
                    "expect": "reject"
                },
                {
                    "text": "05.0 mA",
                    "expect": "survey"
                }
            ]
        },
        {
            "id": "spec5-04-decimal-kilowatthour",
