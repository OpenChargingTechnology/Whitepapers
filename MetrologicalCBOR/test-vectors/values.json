            "source": "spec §5",
            "hex": "D9ACDC84C482211901F40422C4822102",
            "text": "(5.00 ±0.02) mA",
            "parseTexts": [
                {
                    "text": "(5.00 +-0.02) mA",
                    "expect": "accept"
                },
                {
                    "text": "(5.00 +/-0.02) mA",
                    "expect": "survey"
                },
                {
                    "text": "(5.00±0.02) mA",
                    "expect": "survey"
                }
            ]
        },
        {
            "id": "spec5-06-uncertainty-integer",
