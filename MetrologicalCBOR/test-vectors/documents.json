{
    "suite": "documents",
    "description": "Document-level CBOR ↔ JSON conversion (metrological-text.md §3). Map keys of roundtrip cases are in canonical (bytewise) order so that a deterministic re-encoding can reproduce the input.",
    "cases": [
        {
            "id": "meter-reading-sorted",
            "description": "A meter reading with one metrological value; canonical key order",
            "cborHex": "A36474696D6574323032362D30382D31355430383A31343A30305A656D657465726E314953413030303030303030343266656E65726779D9ACDC83C48221186E0203",
            "json": "{\"time\":\"2026-08-15T08:14:00Z\",\"meter\":\"1ISA0000000042\",\"energy\":\"1.10 kWh\"}",
            "roundtrip": true
        },
        {
            "id": "transaction-record-sorted",
            "description": "Two text fields and a reading with a coverage factor; canonical key order",
            "cborHex": "A46474696D6574323032362D30382D31355430383A31343A30305A656D657465726E314953413030303030303030343266656E65726779D9ACDC84C482221A0012D6870203A201C48220187B020267636F6E74657874715472616E73616374696F6E2E426567696E",
            "json": "{\"time\":\"2026-08-15T08:14:00Z\",\"meter\":\"1ISA0000000042\",\"energy\":\"(1234.567 ±12.3) kWh, k=2\",\"context\":\"Transaction.Begin\"}",
            "roundtrip": true
        },
        {
            "id": "worked-example-meter-reading",
            "description": "The unsigned meter reading of the worked signed example (human key order, tag 0 timestamp)",
            "source": "spec, tag-44252-signed-example.md",
            "cborHex": "A5656D657465726E31495341303030303030303034326B7472616E73616374696F6E68613466316339653267636F6E74657874715472616E73616374696F6E2E426567696E6474696D65C074323032362D30382D31355430383A31343A30305A66656E65726779D9ACDC84C482221A0012D6870203A401C48220187B020203C48221185F0401",
            "json": "{\"meter\":\"1ISA0000000042\",\"transaction\":\"a4f1c9e2\",\"context\":\"Transaction.Begin\",\"time\":\"2026-08-15T08:14:00Z\",\"energy\":\"(1234.567 ±12.3) kWh, k=2, p=0.95, dist=normal\"}",
            "roundtrip": false
        },
        {
